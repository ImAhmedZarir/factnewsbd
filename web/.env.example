# Site Public URL (set to your custom domain in production)
NEXT_PUBLIC_SITE_URL=https://factnewsbangladesh.bond

# Supabase (Text-Only Storage + Strict Read-Only RLS)
# Leave blank locally to run against ../data/scraped_seed.json
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Signed Image CDN Wrapper Secret (use the exact same secret in cdn-worker/wrangler.toml)
CDN_SIGNING_SECRET=change-this-to-a-32-byte-random-secret

# Optional external Cloudflare Worker CDN URL (e.g. https://cdn.factnewsbangladesh.bond)
# When unset, uses built-in /api/cdn/image?t=...
NEXT_PUBLIC_CDN_BASE_URL=https://cdn.factnewsbangladesh.bond

# Optional Master PAT & Admin Console Secret for Production
INGEST_PAT_SECRET=
ADMIN_CONSOLE_SECRET=

# Optional Google AdSense Publisher & Slot IDs
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_LEADERBOARD=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
